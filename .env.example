# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. Add the same variables in Vercel → Project → Settings → Environment Variables.

# --- Clerk (clerk.com → your app → API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=paste-your-clerk-publishable-key
CLERK_SECRET_KEY=paste-your-clerk-secret-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Supabase (supabase.com → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only secret. Never prefix with NEXT_PUBLIC_. Used only inside server code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Resend (resend.com → API Keys) ---
# Server-only secret. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=paste-your-resend-api-key
# On the free plan keep the Resend test sender:
EMAIL_FROM="PMS <onboarding@resend.dev>"

# --- App ---
# Used to build links inside emails. Locally: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
